# Copiez ce fichier en « .env » pour un usage local, puis remplacez les valeurs par celles de votre projet Firebase
# (Paramètres du projet > Général > Vos applications > Configuration du SDK).
# Ces valeurs de configuration web ne sont pas des secrets (la sécurité repose sur firestore.rules),
# mais on évite malgré tout de les enregistrer dans le dépôt.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=mon-projet.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mon-projet
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
